# Copy to .env locally. Never commit credentials.
WORKER_TOKEN=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-nano-12b-v2-vl
GUIDE_SERVER_URL=http://127.0.0.1:8000
RUN_CONTEXT=local-dev
GUIDE_COOKIE_SECURE=false
GUIDE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Server speech: Magpie TTS NIM + infra/tts_postfx.py via infra/open_tts_tunnel.sh; empty = browser TTS fallback.
# Approved demo values (2026-10-27): TTS_BASE_URL=http://127.0.0.1:9100, both voices Magpie-Multilingual.EN-US.Mia,
# TTS_SSML_PITCH=x-high (only x-low|low|medium|high|x-high are sent; empty = plain text).
TTS_BASE_URL=
TTS_VOICE_KO=
TTS_VOICE_EN=
TTS_SSML_PITCH=
# New sessions per client IP per minute (default 10). Demo behind one tunnel/NAT IP: 60 recommended.
GUIDE_SESSION_RATE_PER_MIN=

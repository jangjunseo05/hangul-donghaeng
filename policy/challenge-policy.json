{
  "version": 1,
  "filesystem_policy": {
    "include_workdir": false,
    "read_only": ["/app", "/usr", "/lib", "/lib64", "/etc", "/proc", "/dev/urandom", "/hackathon/input"],
    "read_write": ["/tmp", "/dev/null", "/hackathon/output"]
  },
  "landlock": {"compatibility": "hard_requirement"},
  "process": {"run_as_user": "1000", "run_as_group": "1000"},
  "network_policies": {
    "local_model": {
      "binaries": [{"path": "/usr/local/bin/python3.11"}],
      "endpoints": [{
        "host": "host.openshell.internal", "port": 8001,
        "protocol": "rest", "enforcement": "enforce",
        "rules": [{"allow": {"method": "POST", "path": "/v1/chat/completions"}}]
      }]
    }
  }
}

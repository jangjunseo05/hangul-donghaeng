      "lang": "ko",
      "blocks": {
        "what_it_is": {
          "text": "근정전은 경복궁의 중심 건물이에요.",
          "evidence_ids": [
            "wikipedia:geunjeongjeon"
          ],
          "verification": "public_source"
        },
        "why_it_matters": {
          "text": "나라의 큰 의식이나 왕의 명령을 알리는 행사가 여기서 열렸어요.",

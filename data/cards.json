            "visitkorea:gwanghwamun-main-gate"
          ],
          "verification": "public_source"
        },
        "what_to_look_for": {
          "text": "Count the three arched openings: the middle one was for the king, the side ones for the crown prince and officials.",
          "evidence_ids": [
            "visitkorea:gwanghwamun-culture",
            "visitkorea:gwanghwamun-main-gate"
          ],
          "verification": "catalog"
        },
        "fun_fact": {
          "text": "After restoration work, the gate reopened to the public on August 15, 2010.",
          "evidence_ids": [
            "visitkorea:gwanghwamun-culture"
          ],
          "verification": "catalog"
        }
      },
      "visit_note": {
        "text": "Passing through the gate and entering the palace may follow different rules; check on the day.",
        "evidence_ids": [
          "visitkorea:gwanghwamun-operation"
        ],
        "verification": "catalog"
      }
    },
    {

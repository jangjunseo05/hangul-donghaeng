    {
      "place_id": "local:geunjeongjeon",
      "lang": "en",
      "blocks": {
        "what_it_is": {
          "text": "Geunjeongjeon is the main hall of Gyeongbokgung Palace.",
          "evidence_ids": [
            "wikipedia:geunjeongjeon"
          ],
          "verification": "public_source"
        },
        "why_it_matters": {
          "text": "The biggest royal events happened here — state ceremonies and the announcing of royal orders.",
          "evidence_ids": [
            "wikipedia:geunjeongjeon"
          ],
          "verification": "public_source"
        },
        "what_to_look_for": {
          "text": "Look for the rows of small stone markers in front of the hall: they showed officials where to stand by rank during ceremonies.",
          "evidence_ids": [
            "wikipedia:geunjeongjeon"
          ],
          "verification": "public_source"
        },
        "fun_fact": {
          "text": "The hall is a designated National Treasure of South Korea.",
          "evidence_ids": [
            "wikipedia:geunjeongjeon"
          ],
          "verification": "public_source"
        }
      }
    },
    {

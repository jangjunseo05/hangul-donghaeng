    {
      "place_id": "local:gyeongbokgung",
      "lang": "en",
      "blocks": {
        "what_it_is": {
          "text": "Gyeongbokgung is a royal palace built in 1395 — the first palace of Joseon, a Korean royal dynasty.",
          "evidence_ids": [
            "wikipedia:gyeongbokgung",
            "visitseoul:gyeongbokgung-culture"
          ],
          "verification": "catalog"
        },
        "why_it_matters": {
          "text": "It was Joseon's main palace — think of it as the kingdom's headquarters.",
          "evidence_ids": [
            "visitseoul:gyeongbokgung-culture"
          ],
          "verification": "catalog",
          "analogy": true
        },
        "what_to_look_for": {
          "text": "Inside the grounds you can find two museums: the National Palace Museum and the National Folk Museum of Korea.",
          "evidence_ids": [
            "wikipedia:gyeongbokgung"
          ],
          "verification": "public_source"
        },
        "fun_fact": {
          "text": "Its name means \"palace of great blessings.\"",
          "evidence_ids": [
            "wikipedia:gyeongbokgung"
          ],
          "verification": "public_source"
        }
      },
      "visit_note": {
        "text": "Closed on Tuesdays with holiday exceptions; check hours and tickets on the day.",
        "evidence_ids": [
          "visitseoul:gyeongbokgung-operation"
        ],
        "verification": "catalog"
      }
    },
    {
      "place_id": "local:gyeongbokgung",
      "lang": "ko",
      "blocks": {
        "what_it_is": {
          "text": "경복궁은 1395년에 지은 궁궐로, 조선 왕조가 처음 세운 궁궐이에요.",
          "evidence_ids": [
            "wikipedia:gyeongbokgung",
            "visitseoul:gyeongbokgung-culture"
          ],
          "verification": "catalog"
        },
        "why_it_matters": {
          "text": "조선의 중심 궁궐이었어요. 나라의 '본부' 같은 곳이라고 생각하면 쉬워요.",
          "evidence_ids": [
            "visitseoul:gyeongbokgung-culture"
          ],
          "verification": "catalog",
          "analogy": true
        },
        "what_to_look_for": {
          "text": "궁 안에 국립고궁박물관과 국립민속박물관, 두 박물관이 있어요.",
          "evidence_ids": [
            "wikipedia:gyeongbokgung"
          ],
          "verification": "public_source"
        },
        "fun_fact": {
          "text": "'경복궁'은 '큰 복을 누리는 궁궐'이라는 뜻이에요.",
          "evidence_ids": [
            "wikipedia:gyeongbokgung"
          ],
          "verification": "public_source"
        }
      },
      "visit_note": {
        "text": "화요일 정기 휴궁(공휴일 예외 있음). 관람시간·요금은 방문일에 확인하세요.",
        "evidence_ids": [
          "visitseoul:gyeongbokgung-operation"
        ],
        "verification": "catalog"
      }
    },
    {
      "place_id": "local:gwanghwamun",
      "lang": "en",
      "blocks": {
        "what_it_is": {
          "text": "Gwanghwamun is the main south gate of Gyeongbokgung Palace — the palace's front door.",
          "evidence_ids": [
            "visitkorea:gwanghwamun-culture",
            "wikipedia:gwanghwamun"
          ],
          "verification": "catalog",
          "analogy": true
        },
        "why_it_matters": {
          "text": "As the main gate, it is bigger and fancier than the palace's other gates.",

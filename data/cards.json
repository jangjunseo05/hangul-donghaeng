            "wikipedia:geunjeongjeon"
          ],
          "verification": "public_source"
        },
        "what_to_look_for": {
          "text": "건물 앞에 줄지어 선 작은 비석(품계석)을 찾아보세요. 의식 때 관리들이 계급별로 설 자리를 알려 줬어요.",
          "evidence_ids": [
            "wikipedia:geunjeongjeon"
          ],
          "verification": "public_source"
        },
        "fun_fact": {
          "text": "근정전은 대한민국 국보예요.",
          "evidence_ids": [
            "wikipedia:geunjeongjeon"
          ],
          "verification": "public_source"
        }
      }
    },
    {
      "place_id": "local:gyeonghoeru",
      "lang": "en",
      "blocks": {
        "what_it_is": {
          "text": "Gyeonghoeru is a raised banquet hall standing on a small artificial island in a large pond.",
          "evidence_ids": [
            "wikipedia:gyeonghoeru"
          ],
          "verification": "public_source"
        },
        "why_it_matters": {
          "text": "It was the palace's party hall for royal banquets, and today it is a designated National Treasure.",
          "evidence_ids": [
            "wikipedia:gyeonghoeru"
          ],
          "verification": "public_source"
        },
        "what_to_look_for": {
          "text": "Count the stone pillars holding up the first floor — there are 48.",
          "evidence_ids": [
            "wikipedia:gyeonghoeru"
          ],
          "verification": "public_source"
        },
        "fun_fact": {
          "text": "From 1983 to 2007, South Korea's 10,000 won banknote showed a picture of Gyeonghoeru.",
          "evidence_ids": [
            "wikipedia:gyeonghoeru"
          ],
          "verification": "public_source"
        }
      }
    },

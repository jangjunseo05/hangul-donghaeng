      "visit_note": {
        "text": "문 통과와 궁궐 입장 규칙은 다를 수 있어요. 방문일에 확인하세요.",
        "evidence_ids": [
          "visitkorea:gwanghwamun-operation"
        ],
        "verification": "catalog"

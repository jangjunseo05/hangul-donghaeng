  "name": "Gwanghwamun Gate",
  "lang": "en",
  "blocks": {
    "what_it_is": {
      "text": "Gwanghwamun is the main south gate of Gyeongbokgung Palace — the palace's front door.",
      "evidence_ids": [
        "visitkorea:gwanghwamun-culture",
        "khs:gwanghwamun-story"
      ],
      "verification": "catalog",
      "analogy": true,
      "as_of": null
    },
    "why_it_matters": {
      "text": "Unlike other palace gates, it has a two-layer roof on a high stone base, built like a fortress gate to look grand.",
      "evidence_ids": [
        "khs:gwanghwamun-story"
      ],
      "verification": "catalog",
      "analogy": false,
      "as_of": null
    },
    "what_to_look_for": {
      "text": "Count the three arched openings: the middle one was for the king, the side ones for the crown prince and officials.",
      "evidence_ids": [
        "khs:gwanghwamun-story",
        "visitkorea:gwanghwamun-culture"
      ],
      "verification": "catalog",
      "analogy": false,
      "as_of": null
    },
    "fun_fact": {
      "text": "After restoration work, the gate reopened to the public on August 15, 2010.",
      "evidence_ids": [
        "visitkorea:gwanghwamun-culture"
      ],
      "verification": "catalog",
      "analogy": false,
      "as_of": null
    }
  },
  "visit_note": {
    "text": "Passing through the gate and entering the palace may follow different rules; check on the day.",
    "evidence_ids": [
      "visitkorea:gwanghwamun-operation"
    ],
